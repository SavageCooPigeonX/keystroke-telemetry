# Optional: only required for Pigeon Compiler flows that call DeepSeek.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_CODING_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# Set to 1 only when you want prompt-triggered DeepSeek jobs to patch files.
DEEPSEEK_AUTONOMOUS_PROMPT_WRITES=0

# Optional: send Codex/file control-plane receipts through Resend.
FILE_EMAIL_DELIVERY=resend_dry_run
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=File Comedy <contact@myaifingerprint.com>

# Optional: only for MAIF social Supabase post repair apply mode.
# Dry-run reruns work without these.
MAIF_SUPABASE_URL=https://your-project.supabase.co
MAIF_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
MAIF_SOCIAL_COMMENTS_TABLE=maif_social_comments
MAIF_SOCIAL_POSTS_TABLE=maif_social_posts
